# Conexión a MongoDB (misma que usa la API)
MONGO_URI=mongodb://pos:pos@localhost:27017/pos_crm?authSource=admin
MONGO_DB=pos_crm

# MinIO / S3 (misma config que apps/api/.env)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=pos-productos

# Comportamiento del scraper
SCRAPER_DELAY=1.0
SCRAPER_PER_PAGE=80

# Directorio (relativo o absoluto) donde se escriben los JSON generados
SCRAPER_OUT_DIR=output