generator client {
  provider = "prisma-client-js"

}

datasource db {
  provider = "postgresql"
}

enum QuoteStatus {
  borrador
  enviada
  aceptada
  perdida
  vencida
}

model Store {
  id               String     @id @default(uuid())
  name             String
  currency         String     @default("BOB")
  taxRate          Float      @default(0)
  lowStockThreshold Int       @default(5)
  products         Product[]
  clients          Client[]
  sales            Sale[]
  quotes           Quote[]
  kits             Kit[]
  users            User[]
  sequences        Sequence[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model User {
  id           String   @id @default(uuid())
  storeId      String
  store        Store    @relation(fields: [storeId], references: [id])
  name         String
  alias        String?
  phone        String?
  email        String   @unique
  passwordHash String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([storeId])
}

model Sequence {
  storeId String
  store   Store  @relation(fields: [storeId], references: [id])
  name    String
  value   Int    @default(0)

  @@id([storeId, name])
}

model Product {
  id           String   @id @default(uuid())
  storeId      String
  store        Store    @relation(fields: [storeId], references: [id])
  name         String
  sku          String
  category     String   @default("General")
  costPrice    Float
  regularPrice Float    @default(0)
  price        Float
  stock        Int      @default(0)
  imageKey     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([storeId, sku])
}

model Client {
  id        String   @id @default(uuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  name      String
  email     String?
  phone     String?
  ci        String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Sale {
  id           String     @id @default(uuid())
  storeId      String
  store        Store      @relation(fields: [storeId], references: [id])
  number       String
  followNumber Int?
  clientId     String?
  createdBy    String?
  items        SaleItem[]
  subtotal     Float
  discount     Float      @default(0)
  total        Float
  createdAt    DateTime   @default(now())

  @@unique([storeId, number])
  @@unique([storeId, followNumber])
}

model SaleItem {
  id        String @id @default(uuid())
  saleId    String
  sale      Sale   @relation(fields: [saleId], references: [id])
  // Código de producto del catálogo maestro (Mongo): idExterno + fuente
  productId Int?
  fuente    String?
  name      String
  sku       String
  quantity  Int
  unitPrice Float
  subtotal  Float

  @@index([saleId])
  @@index([productId, fuente])
}

model Quote {
  id           String      @id @default(uuid())
  storeId      String
  store        Store       @relation(fields: [storeId], references: [id])
  number       String
  followNumber Int?
  clientId     String?
  clientName   String      @default("Cliente general")
  createdBy    String?
  items        QuoteItem[]
  subtotal     Float
  discount     Float       @default(0)
  total        Float
  validDays    Int         @default(7)
  expiresAt    DateTime
  status       QuoteStatus @default(borrador)
  createdAt    DateTime    @default(now())

  @@unique([storeId, number])
  @@unique([storeId, followNumber])
}

model QuoteItem {
  id            String @id @default(uuid())
  quoteId       String
  quote         Quote  @relation(fields: [quoteId], references: [id])
  // Código de producto del catálogo maestro (Mongo): idExterno + fuente
  productId     Int?
  fuente        String?
  name          String
  sku           String
  quantity      Int
  unitPrice     Float
  originalPrice Float  @default(0)
  subtotal      Float

  @@index([quoteId])
  @@index([productId, fuente])
}

model Kit {
  id            String     @id @default(uuid())
  storeId       String
  store         Store      @relation(fields: [storeId], references: [id])
  name          String
  description   String?
  imageKey      String?
  priceOverride Float?
  items         KitItem[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([storeId])
}

model KitItem {
  id            String @id @default(uuid())
  kitId         String
  kit           Kit    @relation(fields: [kitId], references: [id])
  // Código de producto del catálogo maestro (Mongo): idExterno + fuente
  productId     Int?
  fuente        String?
  name          String
  sku           String
  quantity      Int
  unitPrice     Float
  originalPrice Float  @default(0)
  moneda        String @default("BOB")
  unidad        String?

  @@index([kitId])
  @@index([productId, fuente])
}